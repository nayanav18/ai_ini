"""
guardrail_service.py

Input safety, metric resolution, ambiguity detection and PII protection.

Important behavior:
- Explicit metric phrases are resolved before generic ambiguity detection.
- "total revenue" -> Total_Revenue
- "revenue amount" -> Revenue_Amount
- "net revenue" -> Net_Revenue
- "arpu" / "average revenue per user" -> ARPU
- Generic "revenue" remains ambiguous when multiple revenue fields exist.
"""

import re
import structlog

logger = structlog.get_logger()


# ---------------------------------------------------------------------------
# Result objects
# ---------------------------------------------------------------------------

class ColumnOption:
    def __init__(self, column: str, description: str):
        self.column = column
        self.description = description


class GuardrailResult:
    def __init__(
        self,
        passed: bool,
        action: str,
        message: str = None,
        options: list = None,
        confidence: float = 1.0,
    ):
        self.passed = passed
        self.action = action
        self.message = message
        self.options = options or []
        self.confidence = confidence


