# Prompt injection protection
# ---------------------------------------------------------------------------

INJECTION_PATTERNS = [
    r"ignore\s+(all\s+)?previous\s+instructions",
    r"forget\s+(the\s+)?system\s+prompt",
    r"you\s+are\s+now\s+",
    r"act\s+as\s+if",
    r"pretend\s+(you\s+are|to\s+be)",
