"""
analytics_agent.py — Intent-aware Phase 2 Analytics Agent.

Responsibilities:
- Produce factual analytics answers from BigQuery results.
- Respect the application-level intent routed by IntentRouter.
- Keep conversation separate from analytics.
- Handle analysis, comparison, visualization, and dashboard intents.
- Do not automatically create a chart for ordinary analysis.
- Preserve the existing analytics response structure expected by the frontend.
- Validate generated numbers against retrieved data.
"""

import json
import structlog
import vertexai

from vertexai.generative_models import GenerativeModel, GenerationConfig

from services.persona_service import get_persona_prompt_injection
from services.chart_selector import (
    select_chart_type,
    rows_to_chart_data,
    get_chart_description,
)
from services.guardrail_service import (
    strip_pii,
    validate_numbers_against_data,
)
from config import settings

logger = structlog.get_logger()


